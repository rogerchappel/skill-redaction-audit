{
  "name": "skill-redaction-audit",
  "version": "0.1.0",
  "description": "Local-first CLI and agent skill for auditing public skill bundles for redaction and side-effect risks.",
  "type": "module",
  "bin": {
    "skill-redaction-audit": "./dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "SKILL.md",
    "README.md",
    "docs",
    "fixtures",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/**/*.test.js",
    "smoke": "npm run build && node dist/src/cli.js scan fixtures/leaky-skill --format markdown --fail-on error || test $? -eq 1",
    "validate": "bash scripts/validate.sh",
    "package:smoke": "node scripts/package-smoke.mjs",
    "release:check": "npm run check && npm test && npm run smoke && npm run validate && npm run package:smoke",
    "lint": "npm run check"
  },
  "keywords": [
    "agent-skills",
    "redaction",
    "audit",
    "cli",
    "security"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/skill-redaction-audit.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/skill-redaction-audit/issues"
  },
  "homepage": "https://github.com/rogerchappel/skill-redaction-audit#readme",
  "devDependencies": {
    "@types/node": "^20.14.10",
    "typescript": "^5.5.3"
  }
}
